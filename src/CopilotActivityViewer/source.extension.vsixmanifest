<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
	<Identity Id="CopilotActivityViewer.4b53dc8c-5a5f-4ddd-9c92-379bb302bab0" Version="1.1.0" Language="en-US" Publisher="Local" />
	<DisplayName>Copilot Activity Viewer</DisplayName>
	<Description xml:space="preserve">Tool window that shows, live, what GitHub Copilot agent mode and its sub-agents are doing: agent tree, tool calls, approvals, durations and token usage. Open it from View &gt; Other Windows &gt; Copilot Activity.</Description>
	<Tags>copilot, agent, subagent, activity, monitor</Tags>
  </Metadata>
  <Installation>
	<InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,19.0)">
	  <ProductArchitecture>amd64</ProductArchitecture>
	</InstallationTarget>
	<InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,19.0)">
	  <ProductArchitecture>arm64</ProductArchitecture>
	</InstallationTarget>
  </Installation>
  <Prerequisites>
	<Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
	<Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
  </Assets>
</PackageManifest>
