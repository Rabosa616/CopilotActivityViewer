<UserControl x:Class="CopilotActivityViewer.ToolWindow.ActivityToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:local="clr-namespace:CopilotActivityViewer.ToolWindow"
             xmlns:model="clr-namespace:CopilotActivityViewer.Model"
             Background="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
             TextElement.FontFamily="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontFamilyKey}}"
             TextElement.FontSize="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontSizeKey}}">
    <UserControl.Resources>
        <local:StatusBrushConverter x:Key="StatusBrush" />
        <local:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
        <local:DepthToIndentConverter x:Key="DepthToIndent" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3B8EEA" />

        <Style x:Key="KindChipStyle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" CornerRadius="9" Padding="8,1,8,1" BorderThickness="1"
                                BorderBrush="{Binding Kind, Converter={StaticResource StatusBrush}}" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ChipLabel" Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
                                <TextBlock x:Name="ChipCount" Text="{Binding Count}" FontSize="11" Margin="5,0,0,0" Opacity="0.5" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{Binding Kind, Converter={StaticResource StatusBrush}}" />
                                <Setter TargetName="ChipLabel" Property="Foreground" Value="White" />
                                <Setter TargetName="ChipLabel" Property="Opacity" Value="1" />
                                <Setter TargetName="ChipCount" Property="Foreground" Value="White" />
                                <Setter TargetName="ChipCount" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Chip" Property="Padding" Value="7,0,7,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Session selector -->
        <DockPanel Grid.Row="0" Margin="6,6,6,2">
            <TextBlock DockPanel.Dock="Left" Text="Session" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button DockPanel.Dock="Right" Content="Refresh" Click="OnRefreshClick" Padding="10,2" Margin="8,0,0,0"
                    Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
            <CheckBox DockPanel.Dock="Right" Content="Follow latest" IsChecked="{Binding FollowLatest}" VerticalAlignment="Center" Margin="8,0,0,0"
                      ToolTip="Automatically switch to the session that is currently active"
                      Style="{DynamicResource {x:Static vsshell:VsResourceKeys.CheckBoxStyleKey}}" />
            <ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" ToolTip="{Binding SelectedSession.EventsPath}"
                      Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type model:SessionInfo}">
                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <!-- Summary -->
        <Border Grid.Row="1" Margin="6,4,6,6" Padding="6,4" BorderThickness="1" CornerRadius="2"
                BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}">
            <DockPanel>
                <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                         Fill="{Binding Model.MainAgent.Status, Converter={StaticResource StatusBrush}}" />
                <TextBlock Text="{Binding Model.Summary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Model.Cwd}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="6,0,6,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="160" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="250" />
            </Grid.ColumnDefinitions>

            <!-- Agent tree -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Agents" FontWeight="SemiBold" Margin="2,0,0,4" />
                <TreeView x:Name="AgentTree" ItemsSource="{Binding Model.RootAgents}" SelectedItemChanged="OnAgentSelected"
                          Background="Transparent"
                          Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                          BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}" />
                            <Setter Property="Padding" Value="2,3" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type model:AgentNode}" ItemsSource="{Binding Children}">
                            <StackPanel ToolTip="{Binding Description}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StatusText}" Margin="6,0,0,0" Opacity="0.7" />
                                </StackPanel>
                                <TextBlock Text="{Binding Subtitle}" Margin="15,1,0,0" Opacity="0.7" FontSize="11" />
                                <TextBlock Text="{Binding Stats}" Margin="15,1,0,0" Opacity="0.7" FontSize="11" />
                                <TextBlock Text="{Binding CurrentActivity}" Margin="15,1,0,0" MaxWidth="420" FontSize="11" FontStyle="Italic"
                                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource AccentBrush}"
                                           Visibility="{Binding CurrentActivity, Converter={StaticResource EmptyToCollapsed}}" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Activity timeline -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="80" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="260" MinHeight="60" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="Activity" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,10,0" />
                    <CheckBox DockPanel.Dock="Right" Content="Auto-scroll" IsChecked="{Binding AutoScroll}" VerticalAlignment="Center" Margin="10,0,0,0"
                              Style="{DynamicResource {x:Static vsshell:VsResourceKeys.CheckBoxStyleKey}}" />
                    <Button DockPanel.Dock="Right" Content="Clear filters" Click="OnClearFiltersClick" Padding="8,1" Margin="10,0,0,0"
                            IsEnabled="{Binding HasActiveFilters}"
                            Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
                    <CheckBox DockPanel.Dock="Right" Content="Include sub-agents" IsChecked="{Binding IncludeSubagents}" VerticalAlignment="Center" Margin="10,0,0,0"
                              ToolTip="Show the activity of the selected agent and all the agents it started"
                              Style="{DynamicResource {x:Static vsshell:VsResourceKeys.CheckBoxStyleKey}}" />
                    <ComboBox x:Name="AgentFilter" DockPanel.Dock="Right" Width="190" Margin="8,0,0,0" ItemsSource="{Binding AgentOptions}" SelectedItem="{Binding SelectedAgent}"
                              ToolTip="Show the activity of this agent"
                              Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type model:AgentNode}">
                                <StackPanel Orientation="Horizontal" Margin="{Binding Depth, Converter={StaticResource DepthToIndent}}">
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox x:Name="StatusFilterBox" DockPanel.Dock="Right" Width="120" Margin="8,0,0,0" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}"
                              DisplayMemberPath="Label" ToolTip="Filter by result"
                              Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}" />
                    <Grid>
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" MinWidth="120" VerticalContentAlignment="Center"
                                 Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" />
                        <TextBlock Text="Search (also inside arguments and results)…" IsHitTestVisible="False" Opacity="0.5" Margin="5,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}" />
                    </Grid>
                </DockPanel>

                <ItemsControl x:Name="KindChips" Grid.Row="1" ItemsSource="{Binding KindFilters}" Margin="0,0,0,2" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:KindFilter}">
                            <ToggleButton IsChecked="{Binding IsChecked}" Style="{StaticResource KindChipStyle}"
                                          PreviewMouseLeftButtonDown="OnKindChipMouseDown" MouseRightButtonUp="OnKindChipRightClick"
                                          ToolTip="Click: show/hide this type · Ctrl+Click or right-click: show only this type"
                                          Visibility="{Binding Count, Converter={StaticResource EmptyToCollapsed}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ListBox x:Name="ActivityList" Grid.Row="2" ItemsSource="{Binding Activities}" SelectedItem="{Binding SelectedActivity}"
                         Background="Transparent"
                         Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowTextBrushKey}}"
                         BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type model:ActivityItem}">
                            <Grid Margin="0,1" ToolTip="{Binding Subtitle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TimeText}" Opacity="0.7" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{Binding Kind, Converter={StaticResource StatusBrush}}" CornerRadius="2" Padding="4,0"
                                        Margin="0,0,6,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding KindText}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding AgentLabel}" Opacity="0.8" Margin="0,0,6,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Subtitle, Mode=OneWay}" Foreground="{DynamicResource {x:Static vsui:EnvironmentColors.SystemGrayTextBrushKey}}" />
                                </TextBlock>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <Ellipse Width="8" Height="8" Margin="0,0,5,0" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                    <TextBlock Text="{Binding StatusText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="5" Text="{Binding DurationText}" Opacity="0.7" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" Background="Transparent" />

                <Border Grid.Row="4" BorderThickness="1" BorderBrush="{DynamicResource {x:Static vsui:EnvironmentColors.ToolWindowBorderBrushKey}}">
                    <Grid>
                        <FlowDocumentScrollViewer x:Name="DetailsViewer" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" Focusable="True" />
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,20,0" Padding="8,1" Content="Copy"
                                Click="OnCopyDetailsClick" ToolTip="Copy the raw details as text"
                                Visibility="{Binding SelectedActivity.Details, Converter={StaticResource EmptyToCollapsed}}"
                                Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Grid.ColumnSpan="3" Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8" IsHitTestVisible="False"
                       Visibility="{Binding HasStatusMessage, Converter={StaticResource EmptyToCollapsed}}" />
        </Grid>
    </Grid>
</UserControl>
